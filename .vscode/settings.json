{
    // The subscribe widget posts to https://api.sixsideddice.com, whose CORS allow-list
    // (Blog.Portfolio/infra/functionapp.bicep) permits exactly three origins: the two
    // sixsideddice.com ones and http://localhost:4000. Live Server's defaults land on
    // http://127.0.0.1:5500, which the API answers without any Access-Control-Allow-Origin
    // header, so the subscribe POST fails in the browser. Host matters as much as port here:
    // http://127.0.0.1:4000 is a different origin to http://localhost:4000 and is not allowed.
    "liveServer.settings.port": 4000,
    "liveServer.settings.host": "localhost"
}
